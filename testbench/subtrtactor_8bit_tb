library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity subtractor_8bit_tb is
end subtractor_8bit_tb;

architecture Behavioral of subtractor_8bit_tb is

    component subtractor_8bit
        Port (
            A : in  STD_LOGIC_VECTOR(7 downto 0);
            B : in  STD_LOGIC_VECTOR(7 downto 0);
            D : out STD_LOGIC_VECTOR(7 downto 0)
        );
    end component;

    signal A : STD_LOGIC_VECTOR(7 downto 0);
    signal B : STD_LOGIC_VECTOR(7 downto 0);
    signal D : STD_LOGIC_VECTOR(7 downto 0);

begin

    UUT: subtractor_8bit
        port map (
            A => A,
            B => B,
            D => D
        );

    process
    begin

        -- Test 1: 15 - 3 = 12
        A <= "00001111";
        B <= "00000011";
        wait for 100 ns;

        -- Test 2: 42 - 10 = 32
        A <= "00101010";
        B <= "00001010";
        wait for 100 ns;

        -- Test 3: 85 - 51 = 34
        A <= "01010101";
        B <= "00110011";
        wait for 100 ns;

        -- Test 4: 255 - 1 = 254
        A <= "11111111";
        B <= "00000001";
        wait for 100 ns;

        -- Test 5: 128 - 1 = 127
        A <= "10000000";
        B <= "00000001";
        wait for 100 ns;

        wait;

    end process;

end Behavioral;
